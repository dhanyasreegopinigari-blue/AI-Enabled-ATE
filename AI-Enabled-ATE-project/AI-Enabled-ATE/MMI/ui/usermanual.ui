                    <item>
                     <widget class="QLabel" name="s8WarningText">
                      <property name="text">
                       <string>Integrated circuits containing MOSFETs, CMOS gates, or microcontrollers can be permanently damaged by sub-perceptual static discharge (sub-100V). Use an ESD wrist strap and grounded bench mat.</string>
                      </property>
                      <property name="wordWrap">
                       <bool>true</bool>
