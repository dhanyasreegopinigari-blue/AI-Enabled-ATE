                  </item>
                  <item>
                   <widget class="QLabel" name="faq1Answer">
                    <property name="text">
                     <string>A: Ensure the Ollama service is running in a terminal by executing 'ollama serve'. Check that port 11434 is accessible and not blocked by local firewalls. Verify the host address in Settings.</string>
                    </property>
                    <property name="wordWrap">
                     <bool>true</bool>
                    </property>
                    <property name="role" stdset="0">
                     <string notr="true">faqAnswer</string>
                    </property>
                    <property name="styleSheet">
                     <string>font-size: 12.5px; color: #8ca394; padding-top: 4px;</string>
                    </property>
                   </widget>
                  </item>
