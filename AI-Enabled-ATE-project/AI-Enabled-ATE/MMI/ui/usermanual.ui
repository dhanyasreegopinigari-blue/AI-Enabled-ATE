                     <number>0</number>
                    </property>
                    <item>
                     <widget class="QLabel" name="s8CautionTitle">
                      <property name="text">
                       <string>High-Voltage Energy Hazards (SMPS Capacitors)</string>
                      </property>
                      <property name="wordWrap">
                       <bool>true</bool>
                      </property>
                      <property name="styleSheet">
                       <string>font-size: 13.5px; font-weight: 700; color: #f87171;</string>
                      </property>
                     </widget>
                    </item>
                    <item>
                     <widget class="QLabel" name="s8CautionText">
                      <property name="text">
                       <string>Primary filter capacitors in switched-mode power supplies (SMPS) and motor drives can retain lethal DC voltages (300V-400V+) long after mains power is unplugged. Always measure voltage across capacitor terminals with a meter before touching.</string>
                      </property>
                      <property name="wordWrap">
                       <bool>true</bool>
                      </property>
                      <property name="styleSheet">
                       <string>font-size: 13px;</string>
                      </property>
                     </widget>
                    </item>
                   </layout>
                  </item>
                 </layout>
                </widget>
               </item>
